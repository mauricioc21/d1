{
  "name": "su-todero-d1",
  "version": "1.0.0",
  "description": "Aplicación multiplataforma para escaneo 3D, captura 360° y generación de planos CAD/BIM",
  "private": true,
  "workspaces": [
    "mobile",
    "web",
    "shared"
  ],
  "scripts": {
    "mobile": "cd mobile && npm start",
    "mobile:ios": "cd mobile && npm run ios",
    "mobile:android": "cd mobile && npm run android",
    "web": "cd web && npm run dev",
    "web:build": "cd web && npm run build",
    "install:all": "npm install && cd mobile && npm install && cd ../web && npm install",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\""
  },
  "keywords": [
    "3d-scanning",
    "360-camera",
    "cad",
    "bim",
    "photogrammetry",
    "virtual-tour"
  ],
  "author": "Su Todero D1 Team",
  "license": "PRIVATE",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.2.0"
  }
}
